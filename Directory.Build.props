<Project>

  <!-- Repo-wide build policy, matching the BgDataTypes_Lib / BgMoveGen
       precedent: every project targets one framework, warnings are errors,
       and public surfaces carry XML docs. The test project opts out of
       doc-file generation (its csproj) but keeps warnings-as-errors.

       What belongs here: properties that are uniform across this repo's
       projects *by policy*, so a change is one edit (a future .NET 11 bump is
       one line). What stays in a csproj: anything encoding a per-project
       decision - OutputType, IsPackable, the bgBoEnumeration reference path,
       and the test project's doc-file override.

       It governs this repo's projects only. The referenced projects
       (BgMoveGen, BgDataTypes_Lib, bgBoEnumeration) build under their own. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
